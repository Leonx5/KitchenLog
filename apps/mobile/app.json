{
  "expo": {
    "name": "KitchenLog",
    "slug": "kitchenlog",
    "version": "1.0.0",
    "scheme": "kitchenlog",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.leonokendo.kitchenlog",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F1A15"
      }
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F1A15"
        }
      ],
      "./plugins/withAndroidCpp20",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "cppFlags": "-std=c++20"
          }
        }
      ],
      "expo-sqlite",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f2ac1c1-45f4-425b-b516-83bf2d93661f"
      }
    }
  }
}
